<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 시스템 설정과 상관없이 항상 검정 배경으로 통일 -->
    <style name="Theme.BgRecorder" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorOnSurface">@android:color/white</item>
        <item name="colorOnSurfaceVariant">#CCCCCC</item>
    </style>

    <!-- 화면이 보이지 않는 투명 테마 (바로가기 전용) -->
    <style name="Theme.BgRecorder.Transparent" parent="Theme.BgRecorder">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
